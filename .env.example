# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env)
# Basado en la guía de despliegue para PythonAnywhere
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración General de Django
# ------------------------------------------------------------------------------
# Obligatoria (sin valor por defecto). Genera una clave distinta para cada entorno con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Nunca reutilices el valor de esta plantilla ni lo subas a git.
SECRET_KEY=reemplazar-por-una-clave-generada

# En local: True. En PythonAnywhere (producción): False
DEBUG=True

# Hosts permitidos separados por comas.
# En local: 127.0.0.1,localhost
# En PythonAnywhere: tu-usuario.pythonanywhere.com (solo tu dominio; el código ya no agrega comodines)
ALLOWED_HOSTS=127.0.0.1,localhost

INTERNAL_IPS=127.0.0.1

# ------------------------------------------------------------------------------
# 2. Configuración de Seguridad y Proxy Reverso (PythonAnywhere HTTPS)
# ------------------------------------------------------------------------------
# Dominio de confianza CSRF para peticiones POST (ej: https://tu-usuario.pythonanywhere.com)
CSRF_TRUSTED_ORIGINS=https://tu-dominio.pythonanywhere.com

# En local poner en False. En PythonAnywhere activar en True:
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HSTS en segundos. En local: 0. En producción inicial: 3600 (1 hora)
SECURE_HSTS_SECONDS=0

# ------------------------------------------------------------------------------
# 3. Base de Datos
# ------------------------------------------------------------------------------
# SQLite (por defecto):
DATABASE_URL=sqlite:///db.sqlite3

# MySQL en PythonAnywhere (opcional si usas la base MySQL de PythonAnywhere):
# DATABASE_URL=mysql://tu_usuario:tu_password@tu_usuario.mysql.pythonanywhere-services.com/tu_usuario$nombre_bd
