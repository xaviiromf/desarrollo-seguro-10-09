# Perfil de laboratorio (Docker). Copiar a .env.lab y reemplazar los valores. Nunca subir .env.lab a git.
# Clave nueva: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=reemplazar-por-una-clave-generada
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# El laboratorio usa HTTP en 127.0.0.1: estas opciones se activan solo con HTTPS (producción).
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Contraseñas de las cuentas ficticias (manage.py crear_cuentas_prueba).
LAB_PASSWORD_ANA=reemplazar-por-una-contraseña-larga
LAB_PASSWORD_BETO=reemplazar-por-otra-contraseña-larga
